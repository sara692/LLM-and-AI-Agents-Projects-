# Copy to .env and fill in. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Code-specialised model (good pandas generation, low cost). Any OpenRouter model id works.
OPENROUTER_MODEL=qwen/qwen-2.5-coder-32b-instruct
# Optional comma-separated fallbacks tried by OpenRouter if the primary fails
# OPENROUTER_FALLBACK_MODELS=deepseek/deepseek-chat

# Agent
MAX_RETRIES=5
USE_LLM_MAPPING=true

# Sandbox: "thread" (fast, default) or "process" (child process that can be killed on timeout)
SANDBOX_MODE=thread
SANDBOX_TIMEOUT_S=10
MAX_RESULT_ROWS=50

# Streamlit -> API
API_URL=http://localhost:8000
